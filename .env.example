# Set both names to a unique project name for each checkout on this Docker host.
PROJECT_NAME=research-change-me
COMPOSE_PROJECT_NAME=research-change-me
# Set to the host user's `id -u` and `id -g` before the first build (Linux).
USER_UID=1000
USER_GID=1000

# Host dataset directory. Example: DATASETS_DIR=/home/user/datasets
DATASETS_DIR=./datasets
